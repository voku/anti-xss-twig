{
  "name": "voku/anti-xss-twig",
  "description": "Twig extension for XSS protection.",
  "keywords": [
    "html",
    "security",
    "twig",
    "extension",
    "XSS"
  ],
  "type": "library",
  "config": {
    "sort-packages": true
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Lars Moelleken",
      "homepage": "https://www.moelleken.org/"
    }
  ],
  "autoload": {
    "psr-4": {
      "voku\\": "src/voku/"
    }
  },
  "require": {
    "php": "^8.2",
    "twig/twig": "^3.14",
    "voku/anti-xss": "^4.1.43"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "check": [
      "@phpstan",
      "@test"
    ],
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test": "phpunit --configuration phpunit.xml"
  }
}
